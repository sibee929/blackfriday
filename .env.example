# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Live domain URL (e.g. https://mrkshi.com)
APP_URL="https://mrkshi.com"

# STRIPE_SECRET_KEY: Server-side Stripe secret key (sk_test_... or sk_live_...) for Stripe Checkout sessions.
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Optional Stripe webhook signing secret (whsec_...) for /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# N8N_WEBHOOK_URL: HTTPS webhook URL for Reverse-Shopify order automation in n8n.
N8N_WEBHOOK_URL=

# TELEGRAM_BOT_TOKEN & TELEGRAM_CHAT_ID: Telegram Bot notifications for new orders & Maßchecker specs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# META_PIXEL_ID & META_CAPI_ACCESS_TOKEN: Meta Pixel + optional server-side Conversions API.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# GA4_MEASUREMENT_ID / GTM_ID / TIKTOK_PIXEL_ID: Optional default analytics IDs.
GA4_MEASUREMENT_ID=
GTM_ID=
TIKTOK_PIXEL_ID=

# ADMIN_PASSCODE: Optional passcode override for Reverse-Shopify Admin (otherwise set via first-run UI).
ADMIN_PASSCODE=
